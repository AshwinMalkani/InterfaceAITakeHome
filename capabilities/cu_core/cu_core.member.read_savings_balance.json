{
  "schema_version": "1.1",
  "id": "cu_core.member.read_savings_balance",
  "version": "1.0.0",
  "status": "draft",
  "description": "Look up a member by member number and return their name and share savings balance. Read-only.",
  "app": {
    "product": "cu_core",
    "versions": ">=4.2 <5",
    "surface": "web"
  },
  "entry_route": "/core/main",
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "5-digit member number",
      "sensitivity": "pii",
      "pattern": "\\d{5}"
    }
  ],
  "outputs": [
    {
      "name": "member_name",
      "type": "string",
      "description": "Member's full name as shown on the detail screen",
      "sensitivity": "pii"
    },
    {
      "name": "savings_balance",
      "type": "decimal",
      "description": "Current balance of the Share Savings account",
      "sensitivity": "pii"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "Open Member Inquiry",
      "action": {
        "kind": "click",
        "target": {
          "frame": "menu",
          "strategies": [
            {
              "kind": "role",
              "role": "link",
              "name": "Member Inquiry"
            }
          ]
        }
      },
      "risk": "safe",
      "expect": {
        "kind": "text_present",
        "text": "Member Inquiry",
        "frame": "main"
      },
      "timeout_ms": 10000
    },
    {
      "id": "s2",
      "intent": "Enter member number",
      "action": {
        "kind": "fill",
        "target": {
          "frame": "main",
          "strategies": [
            {
              "kind": "near_text",
              "anchor": "Member Number",
              "control": "textbox"
            },
            {
              "kind": "css",
              "selector": "input[name='f1']"
            }
          ]
        },
        "value": "{{inputs.member_id}}"
      },
      "risk": "safe",
      "timeout_ms": 10000
    },
    {
      "id": "s3",
      "intent": "Run the search",
      "action": {
        "kind": "click",
        "target": {
          "frame": "main",
          "strategies": [
            {
              "kind": "role",
              "role": "button",
              "name": "Search"
            }
          ]
        }
      },
      "risk": "safe",
      "expect": {
        "kind": "text_present",
        "text": "MEMBER DETAIL",
        "frame": "main"
      },
      "timeout_ms": 10000
    },
    {
      "id": "s4",
      "intent": "Read member name",
      "action": {
        "kind": "extract",
        "target": {
          "frame": "main",
          "strategies": [
            {
              "kind": "field_value",
              "label": "Name"
            }
          ]
        },
        "output": "member_name",
        "parse": "text"
      },
      "risk": "safe",
      "timeout_ms": 10000
    },
    {
      "id": "s5",
      "intent": "Read Share Savings balance",
      "action": {
        "kind": "extract",
        "target": {
          "frame": "main",
          "strategies": [
            {
              "kind": "table_cell",
              "row": "Share Savings",
              "column": "Balance"
            },
            {
              "kind": "field_value",
              "label": "Share Savings"
            }
          ]
        },
        "output": "savings_balance",
        "parse": "currency"
      },
      "risk": "safe",
      "timeout_ms": 10000
    }
  ],
  "success": {
    "kind": "text_present",
    "text": "MEMBER DETAIL",
    "frame": "main"
  },
  "provenance": {
    "source": "discovery",
    "recorded_at": "2026-10-03T17:45:39.624129Z",
    "discovery_run_id": "run_20261003T174519_59043f",
    "model": "claude-opus-5-5"
  }
}
